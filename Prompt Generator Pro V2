<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Prompt Generator Pro — Visual & Cinematic Analysis Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        obsidian: '#09090b',
                        surface: '#121216',
                        card: '#18181f',
                        accent: '#6366f1',
                        accentGlow: '#818cf8'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #09090b;
            color: #f4f4f5;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(24, 24, 31, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25);
        }
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(99, 102, 241, 0.4); }
            50% { border-color: rgba(129, 140, 248, 0.9); }
        }
        .analyzing-ring {
            animation: pulse-border 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans antialiased selection:bg-indigo-500/30 selection:text-indigo-200">

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Header -->
    <header class="sticky top-0 z-40 glass-panel border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-bold tracking-tight bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">
                        AI Prompt Generator Pro
                    </h1>
                    <p class="text-[11px] text-zinc-400 hidden sm:block">Deep Visual & Segmented Cinematic Prompt Architecture</p>
                </div>
            </div>

            <!-- Mode Switcher -->
            <div class="flex items-center bg-black/50 p-1 rounded-xl border border-white/10">
                <button id="tabImageMode" onclick="switchMode('image')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-600/20 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Image to Prompt</span>
                </button>
                <button id="tabVideoMode" onclick="switchMode('video')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 text-zinc-400 hover:text-white flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"></path></svg>
                    <span>Video to Prompt</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Workspace -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        
        <!-- ==================== MODE 1: IMAGE TO PROMPT ==================== -->
        <section id="imageWorkspace" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Left Control & Upload Column -->
            <div class="lg:col-span-5 flex flex-col gap-5">
                <div class="glass-panel rounded-2xl p-5 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Mode 1 // Visual Decomposition</span>
                        <span class="text-xs text-zinc-500">10-Point Deep Analysis</span>
                    </div>

                    <!-- Dropzone -->
                    <div id="imageDropzone" onclick="document.getElementById('imageInput').click()" class="relative group cursor-pointer border-2 border-dashed border-white/15 hover:border-indigo-500/60 rounded-2xl p-6 transition-all duration-200 bg-black/30 flex flex-col items-center justify-center min-h-[260px] overflow-hidden">
                        <input type="file" id="imageInput" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                        
                        <div id="imagePlaceholder" class="flex flex-col items-center text-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-white/5 group-hover:bg-indigo-500/20 flex items-center justify-center transition-colors">
                                <svg class="w-6 h-6 text-zinc-400 group-hover:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-zinc-200">Click or drop reference image</p>
                                <p class="text-xs text-zinc-500 mt-1">Supports PNG, JPG, WEBP (High-res recommended)</p>
                            </div>
                        </div>

                        <img id="imagePreview" class="hidden max-h-[340px] w-auto object-contain rounded-xl shadow-2xl" alt="Uploaded Preview">
                    </div>

                    <!-- Aspect Ratio Selector -->
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center justify-between">
                            <label class="text-xs font-medium text-zinc-300">Target Output Aspect Ratio</label>
                            <span id="selectedRatioBadge" class="text-xs font-mono text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded-md border border-indigo-500/20">--ar 16:9</span>
                        </div>
                        <div class="grid grid-cols-4 sm:grid-cols-7 gap-1.5" id="aspectRatioGrid">
                            <button type="button" onclick="selectAspectRatio('1:1')" data-ratio="1:1" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">1:1</button>
                            <button type="button" onclick="selectAspectRatio('16:9')" data-ratio="16:9" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-indigo-500 bg-indigo-600/20 text-white font-semibold transition">16:9</button>
                            <button type="button" onclick="selectAspectRatio('9:16')" data-ratio="9:16" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">9:16</button>
                            <button type="button" onclick="selectAspectRatio('4:3')" data-ratio="4:3" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">4:3</button>
                            <button type="button" onclick="selectAspectRatio('3:4')" data-ratio="3:4" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">3:4</button>
                            <button type="button" onclick="selectAspectRatio('21:9')" data-ratio="21:9" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">21:9</button>
                            <button type="button" onclick="selectAspectRatio('3:2')" data-ratio="3:2" class="ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition">3:2</button>
                        </div>
                    </div>

                    <!-- Analyze Button -->
                    <button id="analyzeImageBtn" onclick="runImageAnalysis()" disabled class="w-full py-3.5 px-5 rounded-xl font-semibold text-sm bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 disabled:opacity-40 disabled:cursor-not-allowed text-white shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span>Generate Deep Image Prompt</span>
                    </button>
                </div>

                <!-- Interactive Unified Prompt Combiner (All aspects can be copied & made into one) -->
                <div id="imageCombinerCard" class="hidden glass-panel rounded-2xl p-5 flex flex-col gap-3">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Unified Aspect Builder</h3>
                        <button onclick="selectAllAttributes(true)" class="text-[11px] text-zinc-400 hover:text-white underline">Select All</button>
                    </div>
                    <p class="text-xs text-zinc-400">Toggle specific analyzed parameters to synthesize a custom merged prompt with your selected aspect ratio:</p>
                    <div id="attributeCheckboxes" class="flex flex-wrap gap-1.5"></div>
                    <div class="bg-black/40 border border-white/10 rounded-xl p-3 text-xs text-zinc-200 font-mono leading-relaxed max-h-36 overflow-y-auto custom-scrollbar" id="mergedCustomPrompt"></div>
                    <div class="flex gap-2">
                        <button onclick="copyTextById('mergedCustomPrompt', 'Merged custom prompt copied!')" class="flex-1 py-2 px-3 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/30 text-emerald-300 text-xs font-medium transition flex items-center justify-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            Copy Merged Prompt
                        </button>
                        <button onclick="downloadTextFile(document.getElementById('mergedCustomPrompt').innerText, 'merged-image-prompt.txt')" class="py-2 px-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-zinc-300 text-xs font-medium transition flex items-center justify-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            .TXT
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Output Column -->
            <div class="lg:col-span-7 flex flex-col gap-5">
                
                <!-- Empty / Loading State -->
                <div id="imageEmptyState" class="glass-panel rounded-2xl p-10 flex flex-col items-center justify-center text-center min-h-[480px] border border-white/10">
                    <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4">
                        <svg class="w-8 h-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                    </div>
                    <h3 class="text-base font-semibold text-zinc-200">Awaiting Visual Input</h3>
                    <p class="text-xs text-zinc-400 max-w-md mt-2 leading-relaxed">Upload an image and click Generate to extract a strict Midjourney/DALL-E/SD English paragraph, 10-layer visual breakdown, and clean JSON schema.</p>
                </div>

                <!-- Image Analysis Results -->
                <div id="imageResultsContainer" class="hidden flex flex-col gap-5">
                    
                    <!-- Global Action Bar -->
                    <div class="glass-panel rounded-2xl p-3.5 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span class="text-xs font-semibold text-zinc-200">Strict Format Output Ready</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button onclick="copyFullStrictImageOutput()" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium transition flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                Copy Full Output
                            </button>
                            <button onclick="downloadFullStrictImageOutput()" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 text-zinc-200 text-xs font-medium transition flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                Download .TXT
                            </button>
                            <button onclick="downloadImageJsonOnly()" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/15 text-zinc-200 text-xs font-medium transition flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                                Download .JSON
                            </button>
                        </div>
                    </div>

                    <!-- ---ENGLISH PROMPT--- Section -->
                    <div class="glass-panel rounded-2xl p-5 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono font-semibold text-indigo-400">---ENGLISH PROMPT---</span>
                            <div class="flex items-center gap-2">
                                <button onclick="copyTextById('imgEnglishPromptText', 'English prompt copied!')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    Copy
                                </button>
                                <button onclick="downloadTextFile(document.getElementById('imgEnglishPromptText').innerText, 'english-prompt.txt')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    Download
                                </button>
                            </div>
                        </div>
                        <div id="imgEnglishPromptText" class="bg-black/40 border border-white/10 rounded-xl p-4 text-sm text-zinc-100 leading-relaxed select-all"></div>
                    </div>

                    <!-- 10 Visual Attributes Cards (Individual Copyable) -->
                    <div class="glass-panel rounded-2xl p-5 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300">10-Point Visual Breakdown (Click any to copy)</span>
                            <span id="imgWordCountBadge" class="text-[11px] font-mono text-zinc-400"></span>
                        </div>
                        <div id="imgBreakdownGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
                    </div>

                    <!-- ---JSON OUTPUT--- Section -->
                    <div class="glass-panel rounded-2xl p-5 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-mono font-semibold text-purple-400">---JSON OUTPUT---</span>
                            <div class="flex items-center gap-2">
                                <button onclick="copyTextById('imgJsonOutputText', 'JSON copied!')" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                    Copy JSON
                                </button>
                                <button onclick="downloadImageJsonOnly()" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    Download JSON
                                </button>
                            </div>
                        </div>
                        <pre id="imgJsonOutputText" class="bg-black/60 border border-white/10 rounded-xl p-4 text-xs font-mono text-emerald-300 overflow-x-auto custom-scrollbar leading-relaxed"></pre>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== MODE 2: VIDEO TO PROMPT ==================== -->
        <section id="videoWorkspace" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Left Video Upload & Keyframe Extractor -->
            <div class="lg:col-span-5 flex flex-col gap-5">
                <div class="glass-panel rounded-2xl p-5 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold uppercase tracking-wider text-purple-400">Mode 2 // Segmented Cinematic</span>
                        <span class="text-xs text-zinc-500">8s Segments • 3 Frames/Seg</span>
                    </div>

                    <!-- Video Dropzone -->
                    <div id="videoDropzone" onclick="document.getElementById('videoInput').click()" class="relative group cursor-pointer border-2 border-dashed border-white/15 hover:border-purple-500/60 rounded-2xl p-6 transition-all duration-200 bg-black/30 flex flex-col items-center justify-center min-h-[240px] overflow-hidden">
                        <input type="file" id="videoInput" accept="video/*" class="hidden" onchange="handleVideoUpload(event)">
                        
                        <div id="videoPlaceholder" class="flex flex-col items-center text-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-white/5 group-hover:bg-purple-500/20 flex items-center justify-center transition-colors">
                                <svg class="w-6 h-6 text-zinc-400 group-hover:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-zinc-200">Click or drop video clip</p>
                                <p class="text-xs text-zinc-500 mt-1">MP4, MOV, WEBM • Auto-splits into 8-second segments</p>
                            </div>
                        </div>

                        <video id="videoPreview" controls class="hidden w-full max-h-[280px] rounded-xl bg-black" onclick="event.stopPropagation()"></video>
                    </div>

                    <!-- Video Telemetry -->
                    <div id="videoTelemetryCard" class="hidden bg-black/40 border border-white/10 rounded-xl p-3.5 grid grid-cols-3 gap-2 text-center">
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-zinc-500">Duration</p>
                            <p id="vidDurationStat" class="text-sm font-mono font-semibold text-white mt-0.5">0.0s</p>
                        </div>
                        <div class="border-x border-white/10">
                            <p class="text-[10px] uppercase tracking-wider text-zinc-500">8s Segments</p>
                            <p id="vidSegmentsStat" class="text-sm font-mono font-semibold text-purple-400 mt-0.5">0</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wider text-zinc-500">Keyframes</p>
                            <p id="vidKeyframesStat" class="text-sm font-mono font-semibold text-emerald-400 mt-0.5">0</p>
                        </div>
                    </div>

                    <!-- Progress Bar during extraction/AI analysis -->
                    <div id="videoProgressWrapper" class="hidden flex flex-col gap-1.5">
                        <div class="flex justify-between text-xs">
                            <span id="videoProgressLabel" class="text-zinc-300">Extracting 3 keyframes per segment...</span>
                            <span id="videoProgressPct" class="font-mono text-purple-400">0%</span>
                        </div>
                        <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                            <div id="videoProgressBar" class="h-full bg-gradient-to-r from-purple-500 to-indigo-500 transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- Analyze Video Button -->
