            downloadTextFile(getStrictImageFormattedText(), 'ai-image-prompt-pro.txt');
        }

        function downloadImageJsonOnly() {
            const json = document.getElementById('imgJsonOutputText').innerText;
            downloadTextFile(json, 'ai-image-prompt-pro.json');
        }

        // ==================== MODE 2: VIDEO TO PROMPT LOGIC ====================
        function handleVideoUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (!file.type.startsWith('video/')) {
                showToast('Please upload a valid video file.', 'error');
                return;
            }

            uploadedVideoFile = file;
            const videoEl = document.getElementById('videoPreview');
            const url = URL.createObjectURL(file);
            videoEl.src = url;
            videoEl.classList.remove('hidden');
            document.getElementById('videoPlaceholder').classList.add('hidden');

            videoEl.onloadedmetadata = () => {
                videoDurationSec = Math.max(1, Math.round(videoEl.duration * 10) / 10);
                const totalSegments = Math.max(1, Math.ceil(videoEl.duration / 8));
                const totalKeyframes = totalSegments * 3;

                document.getElementById('videoTelemetryCard').classList.remove('hidden');
                document.getElementById('vidDurationStat').innerText = `${videoDurationSec}s`;
                document.getElementById('vidSegmentsStat').innerText = `${totalSegments}`;
                document.getElementById('vidKeyframesStat').innerText = `${totalKeyframes}`;
                document.getElementById('analyzeVideoBtn').disabled = false;
                showToast(`Detected ${videoDurationSec}s duration (${totalSegments} segments).`);
            };
        }

        function seekVideoFrame(videoEl, timeInSeconds) {
            return new Promise((resolve) => {
                const targetTime = Math.min(Math.max(0, timeInSeconds), Math.max(0, videoEl.duration - 0.05));
                const onSeeked = () => {
                    videoEl.removeEventListener('seeked', onSeeked);
                    const canvas = document.getElementById('frameCanvas');
                    const scale = Math.min(1, 640 / (videoEl.videoWidth || 640));
                    canvas.width = Math.round((videoEl.videoWidth || 640) * scale);
                    canvas.height = Math.round((videoEl.videoHeight || 360) * scale);
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);
                    const dataUrl = canvas.toDataURL('image/jpeg', 0.78);
                    resolve({
                        time: Math.round(targetTime * 10) / 10,
                        dataUrl,
                        base64: dataUrl.split(',')[1]
                    });
                };
                videoEl.addEventListener('seeked', onSeeked);
                videoEl.currentTime = targetTime;
            });
        }

        async function extractAllSegmentKeyframes(videoEl) {
            const duration = videoEl.duration;
            const totalSegments = Math.max(1, Math.ceil(duration / 8));
            const segments = [];
            const totalSteps = totalSegments * 3;
            let completedSteps = 0;

            for (let i = 0; i < totalSegments; i++) {
                const startSec = i * 8;
                const endSec = Math.min(duration, (i + 1) * 8);
                const segSpan = Math.max(0.1, endSec - startSec);

                // Extract 3 keyframes per segment (start, middle, end)
                const timestamps = [
                    startSec + segSpan * 0.1,
                    startSec + segSpan * 0.5,
                    startSec + segSpan * 0.9
                ];

                const frames = [];
                for (const ts of timestamps) {
                    const frame = await seekVideoFrame(videoEl, ts);
                    frames.push(frame);
                    completedSteps++;
                    const pct = Math.round((completedSteps / totalSteps) * 45);
                    updateVideoProgress(pct, `Extracting Segment ${i + 1}/${totalSegments} keyframes...`);
                }

                segments.push({
                    segmentNumber: i + 1,
                    startSec: Math.round(startSec),
                    endSec: Math.round(endSec),
                    timeRange: `${Math.round(startSec)}-${Math.round(endSec)}`,
                    frames
                });
            }
            return segments;
        }

        function updateVideoProgress(pct, label) {
            const wrap = document.getElementById('videoProgressWrapper');
            wrap.classList.remove('hidden');
            document.getElementById('videoProgressBar').style.width = `${pct}%`;
            document.getElementById('videoProgressPct').innerText = `${pct}%`;
            if (label) document.getElementById('videoProgressLabel').innerText = label;
        }

        function renderExtractedKeyframes(segments) {
            const card = document.getElementById('keyframesGalleryCard');
            const container = document.getElementById('keyframesContainer');
            card.classList.remove('hidden');
            container.innerHTML = '';

            segments.forEach(seg => {
                const row = document.createElement('div');
                row.className = "bg-black/40 border border-white/10 rounded-xl p-3 flex flex-col gap-2";
                row.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-semibold text-purple-300">Segment ${seg.segmentNumber} (${seg.startSec}–${seg.endSec}s)</span>
                        <span class="text-[11px] font-mono text-zinc-500">3 Keyframes</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        ${seg.frames.map((f, idx) => `
                            <div class="relative rounded-lg overflow-hidden border border-white/10 bg-black aspect-video">
                                <img src="${f.dataUrl}" class="w-full h-full object-cover" alt="Frame ${idx + 1}">
                                <span class="absolute bottom-1 right-1 bg-black/80 text-[10px] font-mono text-zinc-200 px-1.5 py-0.5 rounded">${f.time}s</span>
                            </div>
                        `).join('')}
                    </div>
                `;
                container.appendChild(row);
            });
        }

        async function runVideoAnalysis() {
            const videoEl = document.getElementById('videoPreview');
            if (!uploadedVideoFile || !videoEl.duration) return;

            const btn = document.getElementById('analyzeVideoBtn');
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Processing Video...</span>`;

            try {
                updateVideoProgress(5, 'Initializing 8-second segment splitter...');
                extractedSegmentsData = await extractAllSegmentKeyframes(videoEl);
                renderExtractedKeyframes(extractedSegmentsData);

                updateVideoProgress(55, 'Analyzing segments with Gemini Cinematic Director...');

                // Build multimodal prompt containing all segments and their 3 keyframes
                const parts = [{
                    text: `Analyze this video split into ${extractedSegmentsData.length} chronological 8-second segments (total duration: ${Math.round(videoEl.duration)} seconds).
For EACH segment, 3 sequential keyframes (start, middle, end) are provided below.
STRICT REQUIREMENTS:
1. Analyze each segment across all 12 cinematic parameters: main_subject, action_progression, secondary_elements, environment_details, lighting, camera_angle, camera_movement, depth_of_field, visual_texture, cinematic_style, emotional_tone, color_grading.
2. Maintain strong visual, character, lighting, and narrative continuity across consecutive segments.
3. Every text field MUST be descriptive and contain MINIMUM 6 words. Never leave any field empty.
4. "full_prompt" for EVERY segment MUST be a standalone cinematic prompt paragraph of MINIMUM 80 words optimized for AI video generators (Sora, Runway Gen-3, Kling, Veo) with NO markdown.
5. Return strictly valid JSON matching the exact schema.`
                }];

                extractedSegmentsData.forEach(seg => {
                    parts.push({
                        text: `\n--- SEGMENT ${seg.segmentNumber} (Time Range: ${seg.timeRange} seconds) ---`
                    });
                    seg.frames.forEach((frame, idx) => {
                        parts.push({ text: `Keyframe ${idx + 1} at ${frame.time}s:` });
                        parts.push({
                            inlineData: {
                                mimeType: "image/jpeg",
                                data: frame.base64
                            }
                        });
                    });
                });

                const payload = {
                    contents: [{ role: "user", parts }],
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: {
                            type: "OBJECT",
                            properties: {
                                total_duration_seconds: { type: "NUMBER" },
                                segment_length_seconds: { type: "NUMBER" },
                                segments: {
                                    type: "ARRAY",
                                    items: {
                                        type: "OBJECT",
                                        properties: {
                                            segment_number: { type: "INTEGER" },
                                            time_range: { type: "STRING" },
                                            main_subject: { type: "STRING" },
                                            action_progression: { type: "STRING" },
                                            secondary_elements: { type: "STRING" },
                                            environment_details: { type: "STRING" },
                                            lighting: { type: "STRING" },
                                            camera_angle: { type: "STRING" },
                                            camera_movement: { type: "STRING" },
                                            depth_of_field: { type: "STRING" },
                                            visual_texture: { type: "STRING" },
                                            cinematic_style: { type: "STRING" },
                                            emotional_tone: { type: "STRING" },
                                            color_grading: { type: "STRING" },
                                            full_prompt: { type: "STRING" },
                                            quality_tags: { type: "STRING" }
                                        },
                                        required: [
                                            "segment_number", "time_range", "main_subject", "action_progression",
                                            "secondary_elements", "environment_details", "lighting", "camera_angle",
                                            "camera_movement", "depth_of_field", "visual_texture", "cinematic_style",
                                            "emotional_tone", "color_grading", "full_prompt", "quality_tags"
                                        ]
                                    }
                                }
                            },
                            required: ["total_duration_seconds", "segment_length_seconds", "segments"]
                        }
                    }
                };

                const rawJson = await callGeminiWithBackoff(payload);
                updateVideoProgress(95, 'Formatting strict cinematic output...');
                const parsed = JSON.parse(rawJson);

                // Normalize strict structure
                parsed.total_duration_seconds = Math.round(videoEl.duration);
                parsed.segment_length_seconds = 8;
                parsed.segments = parsed.segments.map((seg, idx) => {
                    const meta = extractedSegmentsData[idx] || { segmentNumber: idx + 1, timeRange: `${idx * 8}-${(idx + 1) * 8}` };
                    return {
                        segment_number: meta.segmentNumber,
                        time_range: meta.timeRange,
                        main_subject: String(seg.main_subject || ""),
                        action_progression: String(seg.action_progression || ""),
                        secondary_elements: String(seg.secondary_elements || ""),
                        environment_details: String(seg.environment_details || ""),
                        lighting: String(seg.lighting || ""),
                        camera_angle: String(seg.camera_angle || ""),
                        camera_movement: String(seg.camera_movement || ""),
                        depth_of_field: String(seg.depth_of_field || ""),
                        visual_texture: String(seg.visual_texture || ""),
                        cinematic_style: String(seg.cinematic_style || ""),
                        emotional_tone: String(seg.emotional_tone || ""),
                        color_grading: String(seg.color_grading || ""),
                        full_prompt: String(seg.full_prompt || "").replace(/[*_`#]/g, '').trim(),
                        quality_tags: String(seg.quality_tags || "4K, ultra-detailed, cinematic lighting, dynamic motion, professional color grading")
                    };
                });

                lastVideoResult = parsed;
                renderVideoResults(parsed);
                updateVideoProgress(100, 'Complete!');
                setTimeout(() => document.getElementById('videoProgressWrapper').classList.add('hidden'), 1200);
                showToast('Segmented video prompts generated!');
            } catch (err) {
                console.error(err);
                showToast('Video analysis failed. Please try a shorter or standard MP4 clip.', 'error');
                document.getElementById('videoProgressWrapper').classList.add('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        }

        function renderVideoResults(data) {
            document.getElementById('videoEmptyState').classList.add('hidden');
            document.getElementById('videoResultsContainer').classList.remove('hidden');

            const container = document.getElementById('videoSegmentsCards');
            container.innerHTML = '';

            data.segments.forEach((seg, index) => {
                const displayRange = seg.time_range.replace('-', '–');
                const wordCount = seg.full_prompt.split(/\s+/).filter(Boolean).length;

                const card = document.createElement('div');
                card.className = "bg-black/40 border border-white/10 rounded-2xl p-4 flex flex-col gap-3";
                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-0.5 rounded-md bg-purple-500/20 border border-purple-500/30 text-xs font-mono font-semibold text-purple-300">
                                Segment ${seg.segment_number} (${displayRange}s)
                            </span>
                            <span class="text-[11px] font-mono text-zinc-500">${wordCount} words</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button onclick="copySingleSegment(${index})" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                Copy
                            </button>
                            <button onclick="downloadSingleSegment(${index})" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-zinc-300 flex items-center gap-1 transition">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                .TXT
                            </button>
                        </div>
                    </div>

                    <p class="text-sm text-zinc-100 leading-relaxed select-all">${seg.full_prompt}</p>

                    <details class="group">
                        <summary class="cursor-pointer text-xs font-medium text-indigo-400 hover:text-indigo-300 select-none flex items-center gap-1">
                            <span>Inspect 12 Cinematic Parameters</span>
                            <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </summary>
                        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">1. Main Subject</span><span class="text-zinc-200">${seg.main_subject}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">2. Action Progression</span><span class="text-zinc-200">${seg.action_progression}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">3. Secondary Elements</span><span class="text-zinc-200">${seg.secondary_elements}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">4. Environment Details</span><span class="text-zinc-200">${seg.environment_details}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">5. Lighting</span><span class="text-zinc-200">${seg.lighting}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">6. Camera Angle</span><span class="text-zinc-200">${seg.camera_angle}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">7. Camera Movement</span><span class="text-zinc-200">${seg.camera_movement}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">8. Depth of Field</span><span class="text-zinc-200">${seg.depth_of_field}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">9. Visual Texture</span><span class="text-zinc-200">${seg.visual_texture}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">10. Cinematic Style</span><span class="text-zinc-200">${seg.cinematic_style}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">11. Emotional Tone</span><span class="text-zinc-200">${seg.emotional_tone}</span></div>
                            <div class="bg-white/5 p-2.5 rounded-xl"><span class="text-zinc-400 block text-[10px] uppercase">12. Color Grading</span><span class="text-zinc-200">${seg.color_grading}</span></div>
                        </div>
                    </details>
                `;
                container.appendChild(card);
            });

            document.getElementById('vidJsonOutputText').innerText = JSON.stringify(data, null, 2);
        }

        function copySingleSegment(index) {
            if (!lastVideoResult || !lastVideoResult.segments[index]) return;
            const seg = lastVideoResult.segments[index];
            const text = `Segment ${seg.segment_number} (${seg.time_range.replace('-', '–')}s):\n${seg.full_prompt}`;
            copyToClipboard(text, `Copied Segment ${seg.segment_number} prompt!`);
        }

        function downloadSingleSegment(index) {
            if (!lastVideoResult || !lastVideoResult.segments[index]) return;
            const seg = lastVideoResult.segments[index];
            const text = `Segment ${seg.segment_number} (${seg.time_range.replace('-', '–')}s):\n${seg.full_prompt}`;
            downloadTextFile(text, `segment-${seg.segment_number}-prompt.txt`);
        }

        function getVideoEnglishPromptsBlock() {
            if (!lastVideoResult) return '';
            return lastVideoResult.segments.map(seg =>
                `Segment ${seg.segment_number} (${seg.time_range.replace('-', '–')}s):\n${seg.full_prompt}`
            ).join('\n\n');
        }

        function copyAllVideoEnglishPrompts() {
            copyToClipboard(getVideoEnglishPromptsBlock(), 'Copied all segment prompts!');
        }

        function downloadAllVideoEnglishPrompts() {
            downloadTextFile(getVideoEnglishPromptsBlock(), 'video-english-prompts.txt');
        }

        function getFullStrictVideoFormattedText() {
            const eng = getVideoEnglishPromptsBlock();
            const json = document.getElementById('vidJsonOutputText').innerText;
            return `---ENGLISH PROMPTS---\n${eng}\n\n---JSON OUTPUT---\n${json}`;
        }

        function copyFullStrictVideoOutput() {
            copyToClipboard(getFullStrictVideoFormattedText(), 'Copied full strict video output!');
        }

        function downloadFullStrictVideoOutput() {
            downloadTextFile(getFullStrictVideoFormattedText(), 'ai-video-prompts-pro.txt');
        }

        function downloadVideoJsonOnly() {
            const json = document.getElementById('vidJsonOutputText').innerText;
            downloadTextFile(json, 'ai-video-prompts-pro.json');
        }
    </script>
