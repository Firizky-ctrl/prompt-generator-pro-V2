    <script>
        // ==================== STATE MANAGEMENT ====================
        const apiKey = ""; // Runtime-injected Gemini API Key
        const MODEL_NAME = "gemini-3-flash-preview";

        let currentMode = 'image';
        let selectedAspectRatio = '16:9';
        let uploadedImageBase64 = null;
        let uploadedImageMime = 'image/jpeg';
        let lastImageResult = null;

        let uploadedVideoFile = null;
        let videoDurationSec = 0;
        let extractedSegmentsData = []; // [{ segmentNumber, startSec, endSec, timeRange, frames: [{time, base64}] }]
        let lastVideoResult = null;

        const IMAGE_ATTRIBUTE_KEYS = [
            { key: 'main_subject', label: '1. Main Subject' },
            { key: 'secondary_elements', label: '2. Secondary Elements' },
            { key: 'environment', label: '3. Environment' },
            { key: 'lighting', label: '4. Lighting' },
            { key: 'camera_angle', label: '5. Camera Angle' },
            { key: 'depth_of_field', label: '6. Depth of Field' },
            { key: 'texture_details', label: '7. Texture Details' },
            { key: 'mood', label: '8. Mood' },
            { key: 'color_grading', label: '9. Color Grading' },
            { key: 'style_reference', label: '10. Style Reference' },
            { key: 'quality_tags', label: 'Quality Tags' }
        ];

        // ==================== UI & NAVIGATION ====================
        function switchMode(mode) {
            currentMode = mode;
            const imgWs = document.getElementById('imageWorkspace');
            const vidWs = document.getElementById('videoWorkspace');
            const tabImg = document.getElementById('tabImageMode');
            const tabVid = document.getElementById('tabVideoMode');

            if (mode === 'image') {
                imgWs.classList.remove('hidden');
                vidWs.classList.add('hidden');
                tabImg.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-indigo-600 text-white shadow-md shadow-indigo-600/20 flex items-center gap-2";
                tabVid.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 text-zinc-400 hover:text-white flex items-center gap-2";
            } else {
                imgWs.classList.add('hidden');
                vidWs.classList.remove('hidden');
                tabVid.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 bg-purple-600 text-white shadow-md shadow-purple-600/20 flex items-center gap-2";
                tabImg.className = "px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-all duration-200 text-zinc-400 hover:text-white flex items-center gap-2";
            }
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const borderClass = type === 'error' ? 'border-rose-500/40 bg-rose-950/90 text-rose-200' : 'border-emerald-500/40 bg-zinc-900/95 text-emerald-200';
            toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl border ${borderClass} shadow-2xl text-xs font-medium flex items-center gap-2 backdrop-blur-md transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <span class="w-2 h-2 rounded-full ${type === 'error' ? 'bg-rose-400' : 'bg-emerald-400'}"></span>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function copyToClipboard(text, successMsg = 'Copied to clipboard!') {
            if (!text) return;
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast(successMsg);
            } catch (err) {
                showToast('Failed to copy text', 'error');
            }
            document.body.removeChild(textarea);
        }

        function copyTextById(elementId, successMsg) {
            const el = document.getElementById(elementId);
            if (el) copyToClipboard(el.innerText, successMsg);
        }

        function downloadTextFile(content, filename) {
            const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast(`Downloaded ${filename}`);
        }

        // ==================== DRAG & DROP SETUP ====================
        function setupDropzone(dropzoneId, inputId, handler) {
            const dz = document.getElementById(dropzoneId);
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evtName => {
                dz.addEventListener(evtName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                });
            });
            dz.addEventListener('dragover', () => dz.classList.add('border-indigo-500', 'bg-indigo-500/10'));
            dz.addEventListener('dragleave', () => dz.classList.remove('border-indigo-500', 'bg-indigo-500/10'));
            dz.addEventListener('drop', e => {
                dz.classList.remove('border-indigo-500', 'bg-indigo-500/10');
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    handler({ target: { files } });
                }
            });
        }
        setupDropzone('imageDropzone', 'imageInput', handleImageUpload);
        setupDropzone('videoDropzone', 'videoInput', handleVideoUpload);

        // ==================== GEMINI API HELPER WITH EXPONENTIAL BACKOFF ====================
        async function callGeminiWithBackoff(payload, maxRetries = 4) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`;
            let delay = 1000;

            for (let attempt = 0; attempt <= maxRetries; attempt++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        if ((response.status === 429 || response.status >= 500) && attempt < maxRetries) {
                            await new Promise(res => setTimeout(res, delay));
                            delay *= 2;
                            continue;
                        }
                        const errBody = await response.text();
                        throw new Error(`API Error (${response.status}): ${errBody}`);
                    }

                    const data = await response.json();
                    const text = data?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (!text) throw new Error('Empty response received from model.');
                    return text;
                } catch (err) {
                    if (attempt === maxRetries) throw err;
                    await new Promise(res => setTimeout(res, delay));
                    delay *= 2;
                }
            }
        }

        // ==================== MODE 1: IMAGE TO PROMPT LOGIC ====================
        function selectAspectRatio(ratio) {
            selectedAspectRatio = ratio;
            document.getElementById('selectedRatioBadge').innerText = `--ar ${ratio}`;
            document.querySelectorAll('.ar-btn').forEach(btn => {
                if (btn.dataset.ratio === ratio) {
                    btn.className = "ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-indigo-500 bg-indigo-600/20 text-white font-semibold transition";
                } else {
                    btn.className = "ar-btn py-2 px-1 rounded-xl text-xs font-mono border border-white/10 bg-white/5 text-zinc-400 hover:text-white transition";
                }
            });
            if (lastImageResult) {
                renderImageResults(lastImageResult);
                updateMergedPrompt();
            }
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (!file.type.startsWith('image/')) {
                showToast('Please upload a valid image file.', 'error');
                return;
            }

            uploadedImageMime = file.type;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                uploadedImageBase64 = dataUrl.split(',')[1];
                const preview = document.getElementById('imagePreview');
                preview.src = dataUrl;
                preview.classList.remove('hidden');
                document.getElementById('imagePlaceholder').classList.add('hidden');
                document.getElementById('analyzeImageBtn').disabled = false;
                showToast('Image loaded. Ready for deep visual analysis.');
            };
            reader.readAsDataURL(file);
        }

        async function runImageAnalysis() {
            if (!uploadedImageBase64) return;
            const btn = document.getElementById('analyzeImageBtn');
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><span>Analyzing Visual Layers...</span>`;

            const systemInstruction = `You are AI Prompt Generator Pro, an elite computer-vision and generative-AI prompt engineer.
Analyze the uploaded image with extreme precision across all 10 visual dimensions.
Rules:
1. Never leave any field empty. If details are subtle, infer logically while keeping strictly realistic to the image.
2. Every descriptive field must be rich and detailed (minimum 6 words per field).
3. "full_prompt" MUST be a standalone, ultra-detailed professional paragraph of MINIMUM 80 words optimized for Midjourney, DALL-E 3, and Stable Diffusion, incorporating the target aspect ratio "${selectedAspectRatio}" (e.g., --ar ${selectedAspectRatio}) naturally at the end.
4. No markdown formatting inside any JSON string values.`;

            const userPrompt = `Perform deep 10-point visual analysis on this image. Target aspect ratio is ${selectedAspectRatio}. Return valid JSON matching the exact schema.`;

            const payload = {
                systemInstruction: { parts: [{ text: systemInstruction }] },
                contents: [{
                    role: "user",
                    parts: [
                        { text: userPrompt },
                        { inlineData: { mimeType: uploadedImageMime, data: uploadedImageBase64 } }
                    ]
                }],
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            main_subject: { type: "STRING" },
                            secondary_elements: { type: "STRING" },
                            environment: { type: "STRING" },
                            lighting: { type: "STRING" },
                            camera_angle: { type: "STRING" },
                            depth_of_field: { type: "STRING" },
                            texture_details: { type: "STRING" },
                            mood: { type: "STRING" },
                            color_grading: { type: "STRING" },
                            style_reference: { type: "STRING" },
                            full_prompt: { type: "STRING" },
                            quality_tags: { type: "STRING" }
                        },
                        required: [
                            "main_subject", "secondary_elements", "environment", "lighting",
                            "camera_angle", "depth_of_field", "texture_details", "mood",
                            "color_grading", "style_reference", "full_prompt", "quality_tags"
                        ]
                    }
                }
            };

            try {
                const rawJson = await callGeminiWithBackoff(payload);
                const parsed = JSON.parse(rawJson);

                // Ensure aspect ratio is cleanly integrated if omitted
                if (!parsed.full_prompt.includes(selectedAspectRatio)) {
                    parsed.full_prompt = `${parsed.full_prompt.trim()} --ar ${selectedAspectRatio}`;
                }
                if (!parsed.quality_tags || parsed.quality_tags.trim() === '') {
                    parsed.quality_tags = "8K, ultra-detailed, hyperrealistic, professional lighting, sharp focus";
                }

                lastImageResult = parsed;
                renderImageResults(parsed);
                buildAttributeCombiner(parsed);
                showToast('Deep visual prompt generated successfully!');
            } catch (err) {
                console.error(err);
                showToast('Analysis failed. Please try again.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        }

        function renderImageResults(data) {
            document.getElementById('imageEmptyState').classList.add('hidden');
            document.getElementById('imageResultsContainer').classList.remove('hidden');

            // Strip any accidental markdown from full_prompt
            const cleanEnglish = data.full_prompt.replace(/[*_`#]/g, '').trim();
            document.getElementById('imgEnglishPromptText').innerText = cleanEnglish;

            const wordCount = cleanEnglish.split(/\s+/).filter(Boolean).length;
            document.getElementById('imgWordCountBadge').innerText = `${wordCount} words • AR ${selectedAspectRatio}`;

            // Render 10 breakdown cards
            const grid = document.getElementById('imgBreakdownGrid');
            grid.innerHTML = '';
            IMAGE_ATTRIBUTE_KEYS.forEach(item => {
                const val = data[item.key] || '';
                const card = document.createElement('div');
                card.className = "bg-black/40 hover:bg-black/60 border border-white/10 hover:border-indigo-500/40 rounded-xl p-3 transition cursor-pointer group flex flex-col justify-between gap-1.5";
                card.onclick = () => copyToClipboard(val, `Copied ${item.label}`);
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-[11px] font-semibold text-indigo-300">${item.label}</span>
                        <span class="text-[10px] text-zinc-500 group-hover:text-indigo-400 transition">Copy</span>
                    </div>
                    <p class="text-xs text-zinc-300 leading-relaxed">${val}</p>
                `;
                grid.appendChild(card);
            });

            // Strict JSON formatting (exact keys required)
            const strictJsonObj = {
                main_subject: String(data.main_subject || ""),
                secondary_elements: String(data.secondary_elements || ""),
                environment: String(data.environment || ""),
                lighting: String(data.lighting || ""),
                camera_angle: String(data.camera_angle || ""),
                depth_of_field: String(data.depth_of_field || ""),
                texture_details: String(data.texture_details || ""),
                mood: String(data.mood || ""),
                color_grading: String(data.color_grading || ""),
                style_reference: String(data.style_reference || ""),
                full_prompt: cleanEnglish,
                quality_tags: String(data.quality_tags || "8K, ultra-detailed, hyperrealistic, professional lighting, sharp focus")
            };
            document.getElementById('imgJsonOutputText').innerText = JSON.stringify(strictJsonObj, null, 2);
        }

        function buildAttributeCombiner(data) {
            const card = document.getElementById('imageCombinerCard');
            const container = document.getElementById('attributeCheckboxes');
            card.classList.remove('hidden');
            container.innerHTML = '';

            IMAGE_ATTRIBUTE_KEYS.forEach(item => {
                const label = document.createElement('label');
                label.className = "cursor-pointer select-none inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 hover:border-emerald-500/40 text-[11px] text-zinc-200 transition";
                label.innerHTML = `
                    <input type="checkbox" checked value="${item.key}" onchange="updateMergedPrompt()" class="attr-checkbox accent-emerald-500 rounded">
                    <span>${item.label.replace(/^\d+\.\s/, '')}</span>
                `;
                container.appendChild(label);
            });
            updateMergedPrompt();
        }

        function selectAllAttributes(checked) {
            document.querySelectorAll('.attr-checkbox').forEach(cb => cb.checked = checked);
            updateMergedPrompt();
        }

        function updateMergedPrompt() {
            if (!lastImageResult) return;
            const selectedParts = [];
            document.querySelectorAll('.attr-checkbox:checked').forEach(cb => {
                const val = lastImageResult[cb.value];
                if (val) selectedParts.push(val.replace(/\.$/, ''));
            });
            const merged = selectedParts.length > 0
                ? `${selectedParts.join(', ')}, aspect ratio ${selectedAspectRatio} --ar ${selectedAspectRatio}`
                : `--ar ${selectedAspectRatio}`;
            document.getElementById('mergedCustomPrompt').innerText = merged;
        }

        function getStrictImageFormattedText() {
            const eng = document.getElementById('imgEnglishPromptText').innerText;
            const json = document.getElementById('imgJsonOutputText').innerText;
            return `---ENGLISH PROMPT---\n${eng}\n\n---JSON OUTPUT---\n${json}`;
